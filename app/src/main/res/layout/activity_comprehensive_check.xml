<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c12"
    android:orientation="vertical"
    tools:context="com.skyline.terraexplorer.controllers.ComprehensiveCheckActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/colorPrimary">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:text="资源点检查"
            android:textColor="@color/c12"
            android:textSize="20sp" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/c1">

        <android.support.v7.widget.RecyclerView
            android:id="@+id/check_listview"
            android:layout_width="match_parent"
            android:padding="10dp"
            android:background="@color/c12"
            android:layout_height="wrap_content"/>
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:layout_marginBottom="60dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="检查名字:"
                    android:textColor="@color/c6"
                    android:layout_marginTop="10dp"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/check_name_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="总体情况:"
                    android:textColor="@color/c6"
                    android:layout_marginTop="10dp"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/zongti_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="隐患情况:"
                    android:textColor="@color/c6"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/yinhuan_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="需要整改情况:"
                    android:textColor="@color/c6"
                    android:layout_marginTop="10dp"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/zhenggai_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="检查人:"
                    android:textColor="@color/c6"
                    android:layout_marginTop="10dp"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/check_men_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />


            </LinearLayout>

        </ScrollView>

        <TextView
            android:id="@+id/fankui_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/login_button"
            android:gravity="center"
            android:paddingBottom="10dp"
            android:paddingTop="10dp"
            android:text="保存"
            android:visibility="gone"
            android:textColor="#ffffff"
            android:textSize="16sp" />


    </FrameLayout>
</LinearLayout>
