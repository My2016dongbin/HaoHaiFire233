<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:background="@color/c12"
    android:layout_height="wrap_content">

    <FrameLayout
        android:id="@+id/order_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="@drawable/ic_card"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginRight="90dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="任务详情"
                android:textColor="@color/c7"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="任务名称:"
                        android:textColor="@color/c7"
                        android:singleLine="true"
                        android:minLines="1"
                        android:textSize="15sp"/>
                    <TextView
                        android:id="@+id/order_name_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/c7"
                        android:singleLine="true"
                        android:minLines="1"
                        android:textSize="15sp"/>
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="4dp">
                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="任务地址:"
                        android:textColor="@color/c7"
                        android:singleLine="true"
                        android:minLines="1"
                        android:textSize="15sp"/>
                    <TextView
                        android:id="@+id/order_address_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/c7"
                        android:singleLine="true"
                        android:minLines="1"
                        android:textSize="15sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/textView11"
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:minLines="1"
                        android:singleLine="true"
                        android:text="开始时间:"
                        android:textColor="@color/c7"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/start_time_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/c7"
                        android:singleLine="true"
                        android:minLines="1"
                        android:textSize="15sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="80dp"
                        android:layout_height="wrap_content"
                        android:text="结束时间:"
                        android:textColor="@color/c7"
                        android:singleLine="true"
                        android:minLines="1"
                        android:textSize="15sp"/>
                    <TextView
                        android:id="@+id/end_time_view"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/c7"
                        android:singleLine="true"
                        android:minLines="1"
                        android:textSize="15sp"/>
                </LinearLayout>



            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/daohang_guihua_button"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:text="导航规划"
            android:textColor="@color/c12"
            android:textSize="15sp"
            android:gravity="center"
            android:layout_gravity="right|center_vertical"
            android:background="@drawable/bg_button"/>

    </FrameLayout>


</LinearLayout>