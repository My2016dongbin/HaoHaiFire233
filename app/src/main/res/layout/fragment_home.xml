                android:textSize="14sp"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/ldzz_layout"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_gravity="bottom"
            android:layout_weight="1"
            android:gravity="left"
            android:orientation="vertical"
            android:background="@drawable/background_r"
            android:layout_marginLeft="20dp"
            android:padding="10dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@mipmap/ldzz" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="林地征占"
                android:textColor="@color/textcolor"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/swdyx_layout"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_gravity="bottom"
            android:layout_weight="1"
            android:gravity="left"
            android:orientation="vertical"
            android:background="@drawable/background_p"
            android:layout_marginLeft="20dp"
            android:padding="10dp"
            android:layout_marginRight="20dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@mipmap/swdyx" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="生物多样性"
                android:textColor="@color/textcolor"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/lyxz_layout"
