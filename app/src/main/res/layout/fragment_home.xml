            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@mipmap/slfh" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="森林防火"
                android:textColor="@color/textcolor"
                android:textSize="14sp"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/famous_layout"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_gravity="bottom"
            android:layout_weight="1"
            android:gravity="left"
            android:orientation="vertical"
            android:background="@drawable/background_p"
            android:layout_marginLeft="20dp"
            android:padding="10dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@mipmap/msgm" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="古树名木"
                android:textColor="@color/textcolor"
                android:textSize="14sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/lt_layout"
            android:layout_width="0dp"
            android:layout_height="76dp"
            android:layout_gravity="bottom"
            android:layout_weight="1"
            android:gravity="left"
            android:orientation="vertical"
            android:background="@drawable/background_b"
            android:layout_marginLeft="20dp"
            android:padding="10dp"
            android:layout_marginRight="20dp">

            <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:src="@mipmap/ic_lt" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="绿地监管"
                android:textColor="@color/textcolor"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
    </LinearLayout>
    </ScrollView>
</LinearLayout>
