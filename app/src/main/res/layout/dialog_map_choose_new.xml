<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c12">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="图层切换"
        android:textColor="@color/c7"
        android:textSize="16sp"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="20dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/guge_yingxiang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/guge_yingxiang_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:src="@drawable/ic_google_sl" />

            <TextView
                android:id="@+id/guge_yingxiang_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="谷歌影像"
                android:textSize="15sp"
                android:layout_marginTop="10dp"
                android:textColor="@color/map"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/guge_gaocheng"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/guge_gaocheng_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:src="@drawable/ic_google_gc"/>

            <TextView
                android:id="@+id/gugegaocheng_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="谷歌高程"
                android:textSize="15sp"
                android:layout_marginTop="10dp"
                android:textColor="@color/c7"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/tiandi_shiliang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/tiandi_shiliang_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:src="@drawable/ic_tdt_sl"/>

            <TextView
                android:id="@+id/tiandi_shiliang_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="天地图矢量"
                android:textSize="15sp"
                android:layout_marginTop="10dp"
                android:textColor="@color/c7"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tiandi_yingxiang"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/tiandi_yingxiang_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:src="@drawable/ic_tdt_yx_select"/>

            <TextView
                android:id="@+id/tiandi_yingxiang_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="天地图影像"
                android:textSize="15sp"
                android:layout_marginTop="10dp"
                android:textColor="@color/c7"/>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:visibility="gone"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/gaofen_map"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/gaofen_map_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:src="@drawable/ic_gfmap"/>

            <TextView
                android:id="@+id/gaofen_map_texy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="高分地图"
                android:textSize="15sp"
                android:layout_marginTop="10dp"
                android:textColor="@color/c7"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="二维三维切换"
        android:textColor="@color/c7"
        android:textSize="16sp"
        android:layout_marginTop="20dp"
        android:layout_marginLeft="20dp"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/twod_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/twod_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:src="@drawable/ic_2d_select" />

            <TextView
                android:id="@+id/twod_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="二维地图"
                android:textSize="15sp"
                android:layout_marginTop="10dp"
                android:textColor="@color/map"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/threed_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">
            <ImageView
                android:id="@+id/threed_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:src="@drawable/ic_3d"/>

            <TextView
                android:id="@+id/threed_tezt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="三维地图"
                android:textSize="15sp"
                android:layout_marginTop="10dp"
                android:textColor="@color/c7"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>