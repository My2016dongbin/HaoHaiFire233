<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/c12"
    >

    <FrameLayout
        android:id="@+id/park_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        android:paddingLeft="10dp"
        android:paddingRight="10dp" >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginRight="90dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/park_name_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="巡检人员:123456789"
                android:textSize="13sp"
                android:textColor="@color/c6"/>
            <TextView
                android:id="@+id/park_qu_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="开始时间:123456789"
                android:textSize="13sp"
                android:layout_marginTop="10dp"
                android:textColor="@color/c6"/>

            <TextView
                android:id="@+id/park_weizhi_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="结束时间:123456789"
                android:textSize="13sp"
                android:layout_marginTop="10dp"
                android:textColor="@color/c6"/>
        </LinearLayout>


        <TextView
            android:id="@+id/park_button"
            android:layout_width="80dp"
            android:layout_height="35dp"
            android:text="查看详情"
            android:gravity="center"
            android:textSize="13sp"
            android:layout_gravity="right|center_vertical"
            android:background="@drawable/bg_button_cheng"
            android:textColor="@color/c12"/>

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@color/c1"/>

</LinearLayout>