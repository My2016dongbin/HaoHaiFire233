<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:fab="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@null"
    tools:context=".controllers.TEMainActivity">




    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <com.skyline.terraexplorer.views.TEView
            android:id="@+id/main_teview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_alignParentLeft="true"
            android:layout_alignParentStart="true"
            android:layout_alignParentTop="true"/>

        <ImageButton
            android:id="@+id/mainButton"
            android:layout_width="@dimen/button_size"
            android:layout_height="@dimen/button_size"
            android:layout_alignParentBottom="true"
            android:layout_alignParentLeft="true"
            android:layout_marginBottom="@dimen/main_button_margin"
            android:layout_marginLeft="@dimen/main_button_margin"
            android:background="@drawable/ic_menu"
            android:contentDescription="@string/main_button"
            android:padding="@dimen/button_padding"/>

        <com.skyline.terraexplorer.views.MainMenuView
            android:id="@+id/main_menu"
            android:layout_width="@dimen/main_menu_width"
            android:layout_height="wrap_content"
            android:layout_alignBottom="@+id/mainButton"
            android:layout_alignLeft="@+id/mainButton"
            android:layout_alignStart="@+id/mainButton" />

        <FrameLayout
            android:id="@+id/loadingView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/ic_map_down"
                android:contentDescription="@null"
                android:scaleType="centerInside" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:layout_gravity="center_vertical"
                android:orientation="vertical"
                android:layout_marginTop="150dp"
                android:padding="40dp">



                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical">

                    <ProgressBar
                        style="?android:attr/progressBarStyle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="10dp"
                        android:indeterminateOnly="true" />

                    <TextView
                        android:id="@+id/loadingView_loading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/loading"
                        android:textColor="@color/c7"
                        android:textSize="@dimen/font_size_huge" />
                </LinearLayout>

                <TextView
                    android:id="@+id/loadingView_projectName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/c7"
                    android:textSize="@dimen/font_size_normal" />

            </LinearLayout>
            <ImageView
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_margin="30dp"
                android:adjustViewBounds="true"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:layout_gravity="bottom|right"
                android:src="@drawable/skyline_logo_alpha_60" />
        </FrameLayout>

        <com.skyline.terraexplorer.views.MessageView
            android:id="@+id/main_message_view"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_alignParentBottom="true" />

        <TextView
            android:id="@+id/jiantou"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:gravity="center"
            android:text="按钮"
            android:visibility="gone" />

        <RelativeLayout
            android:id="@+id/temain_location"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentBottom="true"
            android:layout_alignParentRight="true"
            android:layout_marginBottom="22dp"
            android:layout_marginRight="20dp"
            android:background="@drawable/selector_rl_back">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_centerInParent="true"
                android:src="@drawable/seletor_location" />


        </RelativeLayout>

        <TextView
            android:id="@+id/open_weixing_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentRight="true"
            android:layout_marginBottom="80dp"
            android:layout_marginRight="10dp"
            android:background="@drawable/bg_button"
            android:paddingBottom="5dp"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="5dp"
            android:text="返回卫星"
            android:textColor="@color/c12"
            android:textSize="15sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/tuli_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/tuli_list_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/tuli_bg"
                android:orientation="vertical"
                android:padding="10dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_team" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="消防专业队"
                        android:textColor="@color/c12"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_check_station" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="护林检查站"
                        android:textColor="@color/c12"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_monitor" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="视频监控点"
                        android:textColor="@color/c12"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_water_source" />

                    <TextView
                        android:id="@+id/textView9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="水源地"
                        android:textColor="@color/c12"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_watch_tower" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="瞭望塔"
                        android:textColor="@color/c12"
                        android:textSize="12sp" />
                </LinearLayout>

            <!--    <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/res_danger_source" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="危险源"
                        android:textColor="@color/c12"
                        android:textSize="12sp" />
                </LinearLayout>-->

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_res_city_command" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="森林防火检测中心"
                        android:textColor="@color/c12"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_danger_source" />

                    <TextView
                        android:id="@+id/textView10"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="危险源"
                        android:textColor="@color/c12"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_cemetery" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="墓地"
                        android:textColor="@color/c12"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_material_repository" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="物资储备库"
                        android:textColor="@color/c12"
                        android:textSize="12sp" />


                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_helicopter" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="5dp"
                        android:text="直升机机降点"
                        android:textColor="@color/c12"
                        android:textSize="12sp" />

                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tuli_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="1dp"
                android:background="@drawable/tuli_button_new"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:gravity="center"
                    android:padding="5dp"
                    android:text="图例"
                    android:textColor="@color/c12"
                    android:textSize="12sp" />

                <ImageView
                    android:id="@+id/tuli_image"
                    android:layout_width="15dp"
                    android:layout_height="15dp"
                    android:layout_marginTop="5dp"
                    android:src="@drawable/ic_go" />


            </LinearLayout>

        </LinearLayout>

    </RelativeLayout>
    <LinearLayout
        android:id="@+id/resouce_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="right"
        android:layout_marginTop="20dp"
        android:visibility="gone"
        android:layout_marginBottom="170dp"
        android:layout_marginRight="20dp">
        <TextView
            android:id="@+id/job_order_button"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:text="检查   计划"
            android:gravity="center"
            android:background="@drawable/bg_button"
            android:textColor="@color/c12"
            android:textSize="13sp"
            />
        <TextView
            android:id="@+id/resource_find_view"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:text="资源   检索"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/c12"
            android:textSize="13sp"
            />

        <TextView
            android:id="@+id/resource_check_view"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:text="综合   检查"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/c12"
            android:textSize="13sp"
            />
        <TextView
            android:id="@+id/add_resource_view"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:text="添加   资源"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/c12"
            android:textSize="13sp"
            />
        <TextView
            android:id="@+id/check_state_view"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:text="校验  显示"
            android:gravity="center"
            android:layout_marginTop="5dp"
            android:background="@drawable/bg_button"
            android:textColor="@color/c12"
            android:textSize="13sp"
            />
    </LinearLayout>


    <TextView
        android:id="@+id/position_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/c12"
        android:layout_gravity="bottom|right"
        android:visibility="gone"
        android:textSize="13sp"/>

</FrameLayout>