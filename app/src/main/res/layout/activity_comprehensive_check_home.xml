<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c12"
    android:orientation="vertical"
    tools:context="com.skyline.terraexplorer.controllers.ComprehensiveCheckHomeActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@color/colorPrimary">

        <ImageView
            android:id="@+id/back_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="20dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:text="综合检查"
            android:textColor="@color/c12"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/check_list_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="right|center_vertical"
            android:layout_marginTop="12dp"
            android:layout_marginRight="10dp"
            android:text="检查记录"
            android:textColor="@color/c12"
            android:textSize="13sp" />

    </FrameLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:background="@color/c12">


        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginBottom="60dp">
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="选择检查区域"
                            android:textColor="@color/c6"
                            android:textSize="15sp" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="(街道可不选择):"
                            android:textColor="@color/c6"
                            android:textSize="11sp" />

                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal" >

                        <LinearLayout
                            android:id="@+id/qu_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_choose_hui"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingBottom="7dp"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:paddingTop="7dp">

                            <TextView
                                android:id="@+id/qu_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:enabled="true"
                                android:maxEms="6"
                                android:singleLine="true"
                                android:text="请选择区"
                                android:textColor="@color/c6"
                                android:textSize="15sp" />

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:src="@drawable/ic_xiala" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/jiedao_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/bg_choose_hui"
                            android:layout_marginLeft="10dp"
                            android:paddingLeft="10dp"
                            android:paddingRight="10dp"
                            android:paddingTop="7dp"
                            android:paddingBottom="7dp">

                            <TextView
                                android:id="@+id/jiedao_text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/c6"
                                android:textSize="15sp"
                                android:enabled="true"
                                android:maxEms="7"
                                android:singleLine="true"
                                android:text="请选择街道"/>
                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="10dp"
                                android:src="@drawable/ic_xiala"/>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检查名称:"
                        android:textColor="@color/c6"
                        android:layout_marginTop="10dp"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/check_name_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="检查情况:"
                            android:textColor="@color/c6"
                            android:layout_marginTop="10dp"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/check_info_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="暂无检查情况"
                            android:textColor="@color/c6"
                            android:layout_marginTop="10dp"
                            android:layout_marginLeft="5dp"
                            android:textSize="15sp" />
                    </LinearLayout>



                    <EditText
                        android:id="@+id/zhenggai_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:inputType="text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="总体情况:"
                        android:textColor="@color/c6"
                        android:layout_marginTop="10dp"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/zongti_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="存在问题:"
                        android:textColor="@color/c6"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/yinhuan_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />




                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="检查人:"
                        android:textColor="@color/c6"
                        android:layout_marginTop="10dp"
                        android:textSize="15sp" />

                    <EditText
                        android:id="@+id/check_men_view"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text" />



                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FFFFFF"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal" >
                        <android.support.v7.widget.RecyclerView
                            android:id="@+id/phote_recycle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>
                    </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/go_jiancha_view"
                    android:layout_width="100dp"
                    android:layout_height="30dp"
                    android:text="新增检查点"
                    android:gravity="center"
                    android:layout_gravity="right"
                    android:layout_marginRight="20dp"
                    android:background="@drawable/bg_button"
                    android:textColor="@color/c12"
                    android:layout_marginTop="10dp"
                    android:textSize="15sp" />
            </FrameLayout>


        </ScrollView>

        <TextView
            android:id="@+id/save_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginBottom="10dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/login_button"
            android:gravity="center"
            android:paddingBottom="10dp"
            android:paddingTop="10dp"
            android:text="保存"
            android:textColor="#ffffff"
            android:textSize="16sp" />


    </FrameLayout>
</LinearLayout>
