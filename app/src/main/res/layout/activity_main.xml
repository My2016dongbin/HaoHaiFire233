<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/c31"
    tools:context="com.hht.hsatellitemobile.MainActivity">


    <wendu.dsbridge.DWebView
        android:id="@+id/dwebView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/c31"
        android:visibility="invisible" />

    <TextView
        android:id="@+id/map_2d_3d_choose"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|right"
        android:layout_marginBottom="80dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/bg_map_choose_button"
        android:gravity="center"
        android:text="[  2D/3D  ]"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="right|center_vertical"
        android:layout_marginRight="10dp"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/out_login_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_set" />


        <ImageView
            android:id="@+id/huojing_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_list" />

        <ImageView
            android:id="@+id/search_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_search" />

        <ImageView
            android:id="@+id/tuceng_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_tuceng" />

        <ImageView
            android:id="@+id/refresh_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_refresh" />

        <ImageView
            android:id="@+id/open_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:src="@drawable/ic_button_biaohui" />


        <ImageView
            android:id="@+id/open_shipin_app"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_button_shipin"
            android:visibility="gone"/>


        <ImageView
            android:id="@+id/dimian_fire_list"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:src="@drawable/ic_button_huojing" />


    </LinearLayout>


    <pl.droidsonroids.gif.GifImageView
        android:id="@+id/loadging_image"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="center"
        android:src="@drawable/loading" />

    <ImageView
        android:id="@+id/warn_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginRight="10dp"
        android:layout_marginTop="10dp"
        android:src="@drawable/ic_warning" />

    <Button
        android:id="@+id/chaoshi_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@color/c12"
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:text="加载超时，点击重新加载"
        android:textSize="15sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/map_choose_button"
        android:layout_width="100dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|right"
        android:layout_marginBottom="20dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/bg_map_choose_button"
        android:gravity="center"
        android:text="[ 谷歌影像 ]"
        android:textSize="14sp"
        android:visibility="gone" />


</FrameLayout>
